<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RiftLingo</AssemblyName>
    <RootNamespace>RiftLingo</RootNamespace>
    <Version>0.3.0</Version>
    <Authors>RiftLingo contributors</Authors>
    <Description>Gemini screenshot translation overlay for League of Legends chat.</Description>
  </PropertyGroup>

</Project>
