<Window x:Class="RiftLingo.Windows.GeminiPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini 翻譯預覽" Width="760" Height="580" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Gemini 圖片翻譯預覽" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Foreground="#CBD5E1" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="None"/></ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" Text="辨識與台灣口語翻譯" FontWeight="SemiBold" Margin="0,14,0,7"/>
        <TextBox Grid.Row="3" x:Name="TranslationText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="10" Background="#111827" Foreground="White" BorderBrush="#334155"/>
    </Grid>
</Window>
